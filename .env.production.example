# ─────────────────────────────────────────────────────────────────────────────
# NEVARA — Production Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.production and fill all values before deploying.
# NEVER commit this file with real secrets.
# Use: AWS Secrets Manager / HashiCorp Vault / Docker Secrets in production.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED — Server will refuse to start without these in production
# ═══════════════════════════════════════════════════════════════════════════════

# Runtime mode — MUST be 'production'
NODE_ENV=production

# JWT Secret — MUST be 32+ character random hex string
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_REAL_SECRET_MIN_32_CHARS

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nevara:REPLACE_PASSWORD@localhost:5432/bluecarbon

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED — GEE Integration
# ═══════════════════════════════════════════════════════════════════════════════

# URL of the Python GEE microservice
GEE_SERVICE_URL=http://localhost:5001

# GEE Service Account email
GEE_SERVICE_ACCOUNT=nevara-gee@your-project.iam.gserviceaccount.com

# Path to GEE service account JSON key file
GEE_KEY_PATH=/secrets/gee-service-account.json

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Application behavior
# ═══════════════════════════════════════════════════════════════════════════════

PORT=5000
USE_DATABASE=true
LOG_LEVEL=info

# File storage directory (mount persistent volume here)
PRIVATE_OBJECT_DIR=/data/nevara/uploads

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Redis (for Bull job queue)
# ═══════════════════════════════════════════════════════════════════════════════

# If not set, analysis queue runs in-memory (single instance only)
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Error Tracking (Sentry)
# ═══════════════════════════════════════════════════════════════════════════════

# SENTRY_DSN=https://XXXXX@oYYYYYY.ingest.sentry.io/ZZZZZZ

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Rate Limiting Override
# ═══════════════════════════════════════════════════════════════════════════════

# SKIP_RATE_LIMITING=false

# ═══════════════════════════════════════════════════════════════════════════════
# PostgreSQL credentials (for docker-compose)
# ═══════════════════════════════════════════════════════════════════════════════

POSTGRES_DB=bluecarbon
POSTGRES_USER=nevara
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ═══════════════════════════════════════════════════════════════════════════════
# GEE Key file path (for docker-compose volume mount)
# ═══════════════════════════════════════════════════════════════════════════════

GEE_KEY_FILE=/path/to/gee-service-account.json
